# ThreatLens AI Configuration
APP_NAME="ThreatLens AI"
APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths
RAW_DATA_DIR="./raw"
DATA_DIR="./data"
MODELS_DIR="./models"
REPORTS_DIR="./reports"

# Database Configuration (SQLite default; can point to PostgreSQL)
DATABASE_URL="sqlite:///./threatlens.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/threatlens"

# Temporal Windowing Parameters
WINDOW_SIZE_SECONDS=60
FORECAST_HORIZON_SECONDS=300

# Risk Engine Weights
RISK_WEIGHT_CLASSIFIER=0.45
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_FORECAST=0.30

# Risk Severity Thresholds
RISK_THRESH_LOW=0.0
RISK_THRESH_MEDIUM=0.30
RISK_THRESH_HIGH=0.60
RISK_THRESH_CRITICAL=0.85

# Hardware Execution
N_JOBS=4
CHUNK_SIZE=50000
REPLAY_SPEED=1.0
SHAP_SAMPLE_SIZE=500
